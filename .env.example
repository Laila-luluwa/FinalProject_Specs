# ── Required (app will not start without these) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leanstock
JWT_SECRET=replace-with-long-random-secret-min-32-chars

# ── Redis (BullMQ: email queue + dead-stock worker) ──
REDIS_URL=redis://localhost:6379
# Or:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ── Server ──
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost

# Docker Compose: use http://localhost (port 80) for frontend + API proxy
# DeployRocks: set APP_URL and CORS_ORIGINS to your public domain

# ── CORS (comma-separated, no * in production) ──
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://127.0.0.1

# ── SMTP (real 3rd party — required in production) ──
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=LeanStock <no-reply@leanstock.local>

# ── Optional OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/oauth/callback
