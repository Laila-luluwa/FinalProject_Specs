# ── Required (app will not start without these) ──
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/leanstock
JWT_SECRET=replace-with-long-random-secret-min-32-chars
# DeployRocks rubric alias (optional if JWT_SECRET is set):
JWT_SECRET_KEY=

# ── Redis (BullMQ: email queue + dead-stock worker) ──
REDIS_URL=redis://redis:6379

# ── Server ──
NODE_ENV=development
ENVIRONMENT=development
PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=8888

# Public URL of your deployed app (DeployRocks or Render)
APP_URL=http://localhost:8888
CLIENT_URL=http://localhost:8888

# ── CORS (comma-separated; no * in production) ──
CORS_ORIGINS=http://localhost:8888,http://localhost:3001,http://127.0.0.1

# ── SMTP — Brevo (recommended for Render) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email@example.com
SMTP_PASS=xsmtpsib-your-brevo-smtp-key
EMAIL_FROM=LeanStock <verified-sender@yourdomain.com>
# Brevo aliases:
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=

# Gmail alternative:
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=your@gmail.com
# SMTP_PASS=google-app-password

# ── Local without Docker: use localhost hosts ──
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leanstock
# REDIS_URL=redis://localhost:6379

# ── Optional OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/oauth/callback
